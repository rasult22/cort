# Copy to .env for local development. In production the same names are set as variables of the service.
# Everything is optional: with nothing set the server runs, guests play, and data lives in a local folder.

# Sign-in with Google: the OAuth client id of the web app (Google Cloud Console → Credentials).
# It is public. Several may be listed, comma-separated (the mobile apps' ids go after the web one).
# Without it the sign-in button is not shown and everyone plays as a guest.
GOOGLE_CLIENT_ID=

# Postgres for accounts, match history and tables in progress, e.g. postgres://user:password@host:5432/cort
# Without it the data is kept in apps/server/.data (PGlite) — fine for development, lost on every deploy.
DATABASE_URL=

# Seconds a player has for a move before it is made for them. 0 switches the clock off.
TURN_SECONDS=30

# Development only: shows a "sign in without Google" button that lets anyone be anyone.
# Ignored when NODE_ENV=production.
DEV_LOGIN=

# Development only: bots move almost at once, so a whole match takes a couple of minutes.
# Used by tools/online-check.mjs. Ignored when NODE_ENV=production.
FAST_BOTS=

# PORT=8787
# DATA_DIR=
