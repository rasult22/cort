{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/apps/server/**",
      "/apps/web/**",
      "/packages/**",
      "/package.json",
      "/pnpm-workspace.yaml",
      "/tsconfig.base.json",
      "/Dockerfile",
      "/.dockerignore",
      "/railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "overlapSeconds": 0,
    "drainingSeconds": 5
  }
}
