{
  "name": "cort",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @cort/web dev",
    "dev:server": "pnpm --filter @cort/server dev",
    "dev:mobile": "pnpm --filter @cort/mobile start",
    "build": "pnpm --filter @cort/web build",
    "start:server": "pnpm --filter @cort/server start",
    "test": "vitest run",
    "test:mobile": "maestro test apps/mobile/.maestro/play-with-bots.yaml",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "typescript": "~5.7.2",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20"
  }
}
